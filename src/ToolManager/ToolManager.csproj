<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ToolManagerProduction Condition="'$(ToolManagerProduction)' == '' and '$(_IsPublishing)' == 'true'">true</ToolManagerProduction>
    <ToolManagerProduction Condition="'$(ToolManagerProduction)' == ''">false</ToolManagerProduction>
    <DefineConstants Condition="'$(ToolManagerProduction)' != 'true'">$(DefineConstants);TOOLMANAGER_DEV</DefineConstants>
    <ApplicationIcon Condition="'$(ToolManagerProduction)' == 'true'">Assets/ToolManager.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(ToolManagerProduction)' != 'true'">Assets/ToolManager-dev.ico</ApplicationIcon>
    <AssemblyName>ToolManager</AssemblyName>
    <!-- WPF owns DPI awareness; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" GeneratePathProperty="true" />
    <EmbeddedResource Include="$(PkgCronos)/LICENSE" LogicalName="ToolManager.Cronos.LICENSE" Condition="'$(PkgCronos)' != ''" />
    <Resource Include="Assets/ToolManager.ico" />
    <Resource Include="Assets/ToolManager-dev.ico" Condition="'$(ToolManagerProduction)' != 'true'" />
  </ItemGroup>
</Project>
